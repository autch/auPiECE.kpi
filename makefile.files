# file macros

WAVE=muslib/wave

WAVEDATA = $(WAVE)/i_BD909$(OBJEXT) $(WAVE)/i_HC909$(OBJEXT) $(WAVE)/i_SDGATE$(OBJEXT) \
	$(WAVE)/i_TOMM1$(OBJEXT) $(WAVE)/i_CYMBD$(OBJEXT) $(WAVE)/i_HO909$(OBJEXT) \
	$(WAVE)/i_TOMH1$(OBJEXT) $(WAVE)/i_HANDCLAP$(OBJEXT) $(WAVE)/i_SD909$(OBJEXT) \
	$(WAVE)/i_TOML1$(OBJEXT)
MUSLIB = muslib/exp12$(OBJEXT) muslib/instdef$(OBJEXT) muslib/mus$(OBJEXT) muslib/seq$(OBJEXT) \
	muslib/wavetable$(OBJEXT)
DLLOBJ=dllexports$(OBJEXT) winlayer$(OBJEXT)

OBJS = $(MUSLIB) $(WAVEDATA) $(DLLOBJ)
