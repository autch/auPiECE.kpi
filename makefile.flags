.PHONY: all clean install binarc srcarc arc diff patch patarc unpatch

KBMPLAY=c:/program\ files/kbmedia\ player/plugins/autch/auPiECE/

ifeq ($(COMPILER),cygwin)
  OBJEXT=.o
  ENVFLAGS = -mno-cygwin
  CFLAGS = -O3 -fomit-frame-pointer -Imuslib
  WFLAGS = -Wall -Werror
  DLLFLAGS = --target=i386-mingw32 -k --add-stdcall-alias
  DBGFLAGS = -s

  CC = gcc
  CXX = g++

  OUTPUT=-o 
  COMPILEONLY=-c

  MAKEDLL = dllwrap $(DBGFLAGS) $(ENVFLAGS) $(DLLFLAGS) --dllname=$@ --def=$(DEF) $(OBJS) -lshlwapi -lstdc++
else
ifeq ($(COMPILER),borland)
  OBJEXT=.obj
  ENVFLAGS = -q
  CFLAGS = -O2vc -ff -X -RT- -Imuslib
  WFLAGS = -w-8057
  DLLFLAGS = /C /c /Tpd /Gn /q /v-
  DBGFLAGS = -v-

  CC = bcc32
  CXX = bcc32

  OUTPUT=-o
  COMPILEONLY=-c

  LIBS=shlwapi import32 noeh32 cw32
  MAKEDLL = ilink32 $(DBGFLAGS) $(ENVFLAGS) $(DLLFLAGS) c0d32x.obj $(subst /,\\,$(OBJS)), $@, , $(LIBS), $(DEF)
endif
endif

.SUFFIXES: .c $(OBJEXT) .dll .kpi .h .cpp

.c$(OBJEXT):
	$(CC) $(COMPILEONLY) $(DBGFLAGS) $(ENVFLAGS) $(WFLAGS) $(CFLAGS) $(OUTPUT)$@ $<
.cpp$(OBJEXT):
	$(CXX) $(COMPILEONLY) $(DBGFLAGS) $(ENVFLAGS) $(WFLAGS) $(CFLAGS) $(OUTPUT)$@ $<
